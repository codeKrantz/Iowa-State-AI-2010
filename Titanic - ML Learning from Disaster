dgecolor=SURFACE, linewidth=2, zorder=3)\n","ax1.bar_label(bars, labels=[f\"{s:.3f}\" for s in scores], padding=4,\n","              color=INK, fontsize=9.5, fontweight=\"bold\")\n","ax1.axhline(scores.mean(), color=MUTED, linewidth=1, zorder=2)\n","ax1.text(-0.45, scores.mean() + 0.006, f\"mean {scores.mean():.3f}\",\n","         ha=\"left\", color=MUTED, fontsize=9)\n","ax1.set_ylim(0.6, 0.92)\n","ax1.set_ylabel(\"Accuracy\")\n","ax1.set_title(\"5-fold cross-validated accuracy\")\n","tidy(ax1)\n","\n","im = ax2.imshow(cm, cmap=BLUES, vmin=0, vmax=cm.max())\n","ax2.set_xticks(range(2), labels)\n","ax2.set_yticks(range(2), labels)\n","ax2.set_xlabel(\"Predicted\")\n","ax2.set_ylabel(\"Actual\")\n","for i in range(2):\n","    for j in range(2):\n","        ax2.text(j, i, f\"{cm[i, j]}\", ha=\"center\", va=\"center\", fontsize=17,\n","                 fontweight=\"bold\", color=\"#ffffff\" if cm[i, j] > cm.max() * 0.55 else INK)\n","ax2.set_title(\"Confusion matrix (cross-validated)\")\n","ax2.grid(False)\n","cell_gaps(ax2, 2, 2)\n","for s in ax2.spines.values():\n","    s.set_visible(False)\n","\n","plt.tight_layout()\n","plt.show()\n","\n","print(f\"Cross-validated accuracy: {scores.mean():.3f} (+/- {scores.std():.3f})\")\n","print(f\"Missed survivors (predicted dead, actually lived): {cm[1, 0]}\")\n","print(f\"False alarms  (predicted alive, actually died):    {cm[0, 1]}\")"]},{"cell_type":"code","execution_count":18,"id":"425ee949","metadata":{"execution":{"iopub.execute_input":"2026-09-04T02:46:08.601006Z","iopub.status.busy":"2026-09-04T02:46:08.600418Z","iopub.status.idle":"2026-09-04T02:46:08.962242Z","shell.execute_reply":"2026-09-04T02:46:08.961105Z"},"papermill":{"duration":0.381148,"end_time":"2026-09-04T02:46:08.965718+00:00","exception":false,"start_time":"2026-09-04T02:46:08.58457+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 935x396 with 1 Axes>"]},"metadata":{},"output_type":"display_data"},{"