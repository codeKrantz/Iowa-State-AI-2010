pe, X_val.shape, y_train.shape, y_val.shape)"]},{"cell_type":"markdown","id":"e72a71e3","metadata":{"papermill":{"duration":0.004525,"end_time":"2026-09-25T20:04:40.135211+00:00","exception":false,"start_time":"2026-09-25T20:04:40.130686+00:00","status":"completed"},"tags":[]},"source":["# Training a Model Using the Data\n","* Start with the simplest model first"]},{"cell_type":"code","execution_count":8,"id":"2ce56206","metadata":{"execution":{"iopub.execute_input":"2026-09-25T20:04:40.147759Z","iopub.status.busy":"2026-09-25T20:04:40.147225Z","iopub.status.idle":"2026-09-25T20:04:40.743162Z","shell.execute_reply":"2026-09-25T20:04:40.741848Z"},"papermill":{"duration":0.603819,"end_time":"2026-09-25T20:04:40.744791+00:00","exception":false,"start_time":"2026-09-25T20:04:40.140972+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Linear Regression model trained.\n"]}],"source":["from sklearn.linear_model import LinearRegression\n","from sklearn.impute import SimpleImputer\n","from sklearn.preprocessing import OneHotEncoder\n","from sklearn.compose import ColumnTransformer\n","from sklearn.pipeline import Pipeline\n","\n","# Identify column types\n","numeric_cols = X_train.select_dtypes(include=[np.number]).columns.tolist()\n","categorical_cols = X_train.select_dtypes(include=['object']).columns.tolist()\n","\n","# Preprocessing: impute numeric (median) and categorical (most frequent), then one-hot encode categoricals\n","numeric_transformer = SimpleImputer(strategy='median')\n","categorical_transformer = Pipeline(steps=[\n","    ('imputer', SimpleImputer(strategy='most_frequent')),\n","    ('onehot', OneHotEncoder(handle_unknown='ignore'))\n","])\n","\n","preprocessor = ColumnTransformer(transformers=[\n","    ('num', numeric_transformer, numeric_cols),\n","    ('cat', categorical_transformer, categorical_cols)\n","])\n","\n","# Full pipeline: preprocessing + linear regression\n","lr_pipeline = Pipeline(steps=[\n","    ('preprocessor', preprocessor),\n","    ('model', LinearRegression())\n","])\n","\n","lr_pipeline.fit(X_train, y_train)\n","\n","print(\"Linear Regression model trained.\")"]},{"cell_type":"markdown","id":"652ebe75","metadata":{"papermill":{"duration":0.004641,"end_time":"2026-09-25T20:04:40.754516+00:00","exception":false,"start_time":"2026-09-25T20:04:40.749875+00:00","status":"completed"},"tags":[]},"source":["# Evaluation"]},{"cell_type":"code","execution_count":9,"id":"a5a7acc4","metadata":{"execution":{"iopub.execute_input":"2026-09-25T20:04:40.766463Z","iopub.status.busy":"2026-09-25T20:04:40.765768Z","iopub.status.idle":"2026-09-25T20:04:40.790858Z","shell.execute_reply":"2026-09-25T20:04:40.789082Z"},"papermill":{"duration":0.033496,"end_time":"2026-09-25T20:04:40.792668+00:00","exception":false,"start_time":"2026-09-25T20:04:40.759172+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["R^2 Score: 0.8720\n","MSE: 981,430,763.46\n","RMSE: 31,327.80\n"]}],"source":["from sklearn.metrics import r2_score, mean_squared_error\n","\n","y_pred = lr_pipeline.predict(X_val)\n","\n","r2 = r2_score(y_val, y_pred)\n","mse = mean_squared_error(y_val, y_pred)\n","rmse = np.sqrt(mse)\n","\n","print(f\"R^2 Score: {r2:.4f}\")\n","print(f\"MSE: {mse:,.2f}\")\n","print(f\"RMSE: {rmse:,.2f}\")"]},{"cell_type":"markdown","id":"68f7dee1","metadata":{"papermill":{"duration":0.005265,"end_time":"2026-09-25T20:04:40.803294+00:00","exception":false,"start_time":"2026-09-25T20:04:40.798029+00:00","status":"completed"},"tags":[]},"source":["# Feature Engineering\n","* Adding features to improve performance"]},{"cell_type":"code","execution_count":10,"id":"fd9a981e","metadata":{"execution":{"iopub.execute_input":"2026-09-25T20:04:40.815821Z","iopub.status.busy":"2026-09-25T20:04:40.815519Z","iopub.status.idle":"2026-09-25T20:04:40.838307Z","shell.execute_reply":"2026-09-25T20:04:40.837399Z"},"papermill":{"duration":0.031397,"end_time":"2026-09-25T20:04:40.840023+00:00","exception":false,"start_time":"2026-09-25T20:04:40.808626+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def add_features(df):\n","    df = df.copy()\n","\n","    # --- Create engineered features first ---\n","    df['TotalSF'] = df['TotalBsmtSF'].fillna(0) + df['1stFlrSF'].fillna(0) + df['2ndFlrSF'].fillna(0)\n","    df['HouseAge'] = df['YrSold'] - df['YearBuilt']\n","    df['RemodAge'] = df['YrSold'] - df['YearRemodAdd']\n","    df['TotalBathrooms'] = (df['FullBath'].fillna(0) + 0.5 * df['HalfBath'].fillna(0) +\n","                             df['BsmtFullBath'].fillna(0) + 0.5 * df['BsmtHalfBath'].fillna(0))\n","    df['TotalPorchSF'] = (df['OpenPorchSF'].fillna(0) + df['EnclosedPorch'].fillna(0) +\n","                           df['3SsnPorch'].fillna(0) + df['ScreenPorch'].fillna(0))\n","    df['HasPool'] = (df['PoolArea'].fillna(0) > 0).astype(int)\n","    df['HasGarage'] = (df['GarageArea'].fillna(0) > 0).astype(int)\n","    df['HasFireplace'] = (df['Fireplaces'].fillna(0) > 0).astype(int)\n","    df['Has2ndFloor'] = (df['2ndFlrSF'].fillna(0) > 0).astype(int)\n","    df['IsRemodeled'] = (df['YearBuilt'] != df['YearRemodAdd']).astype(int)\n","\n","    # --- Drop the raw columns that are now exact linear combinations of new features ---\n","    # (This is what was causing near-singular matrices / unstable coefficients in Linear Regression)\n","    redundant_cols = ['TotalBsmtSF', '1stFlrSF', '2ndFlrSF',\n","                       'YearBuilt', 'YearRemodAdd',\n","                       'FullBath', 'HalfBath', 'BsmtFullBath', 'BsmtHalfBath',\n","                       'OpenPorchSF', 'EnclosedPorch', '3SsnPorch', 'ScreenPorch']\n","    df = df.drop(columns=redundant_cols)\n","\n","    return df\n","\n","X_train_fe = add_features(X_train)\n","X_val_fe = add_features(X_val)"]},{"cell_type":"code","execution_count":11,"id":"037ae07a","metadata":{"execution":{"iopub.execute_input":"2026-09-25T20:04:40.851876Z","iopub.status.busy":"2026-09-25T20:04:40.851493Z","iopub.status.idle":"2026-09-25T20:04:40.942995Z","shell.execute_reply":"2026-09-25T20:04:40.941464Z"},"papermill":{"duration":0.099892,"end_time":"2026-09-25T20:04:40.945059+00:00","exception":false,"start_time":"2026-09-25T20:04:40.845167+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["R^2 Score (with new features): 0.8767\n","MSE (with new features): 946,015,158.26\n","RMSE (with new features): 30,757.36\n"]}],"source":["numeric_cols_fe = X_train_fe.select_dtypes(include=[np.number]).columns.tolist()\n","categorical_cols_fe = X_train_fe.select_dtypes(include=['object']).columns.tolist()\n","\n","preprocessor_fe = ColumnTransformer(transformers=[\n","    ('num', SimpleImputer(strategy='median'), numeric_cols_fe),\n","    ('cat', Pipeline(steps=[\n","        ('imputer', SimpleImputer(strategy='most_frequent')),\n","        ('onehot', OneHotEncoder(handle_unknown='ignore'))\n","    ]), categorical_cols_fe)\n","])\n","\n","lr_pipeline_fe = Pipeline(steps=[\n","    ('preprocessor', preprocessor_fe),\n","    ('model', LinearRegression())\n","])\n","\n","lr_pipeline_fe.fit(X_train_fe, y_train)\n","\n","y_pred_fe = lr_pipeline_fe.predict(X_val_fe)\n","\n","r2_fe = r2_score(y_val, y_pred_fe)\n","mse_fe = mean_squared_error(y_val, y_pred_fe)\n","rmse_fe = np.sqrt(mse_fe)\n","\n","print(f\"R^2 Score (with new features): {r2_fe:.4f}\")\n","print(f\"MSE (with new features): {mse_fe:,.2f}\")\n","print(f\"RMSE (with new features): {rmse_fe:,.2f}\")"]},{"cell_type":"markdown","id":"369c7e61","metadata":{"papermill":{"duration":0.004706,"end_time":"2026-09-25T20:04:40.954703+00:00","exception":false,"start_time":"2026-09-25T20:04:40.949997+00:00","status":"completed"},"tags":[]},"source":["# Advanced Models"]},{"cell_type":"code","execution_count":12,"id":"2091298b","metadata":{"execution":{"iopub.execute_input":"2026-09-25T20:04:40.966158Z","iopub.status.busy":"2026-09-25T20:04:40.965743Z","iopub.status.idle":"2026-09-25T20:04:49.194001Z","shell.execute_reply":"2026-09-25T20:04:49.193268Z"},"papermill":{"duration":8.237302,"end_time":"2026-09-25T20:04:49.196686+00:00","exception":false,"start_time":"2026-09-25T20:04:40.959384+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Decision Tree: RMSE = 43,318.92\n","KNN: RMSE = 48,733.60\n","Random Forest: RMSE = 31,060.96\n","XGBoost: RMSE = 28,650.97\n"]}],"source":["from sklearn.tree import DecisionTreeRegressor\n","from sklearn.neighbors import KNeighborsRegressor\n","from sklearn.ensemble import RandomForestRegressor\n","from xgboost import XGBRegressor\n","\n","models = {\n","    'Decision Tree': DecisionTreeRegressor(random_state=42),\n","    'KNN': KNeighborsRegressor(),\n","    'Random Forest': RandomForestRegressor(random_state=42, n_estimators=100),\n","    'XGBoost': XGBRegressor(random_state=42)\n","}\n","\n","results = {}\n","\n","for name, model in models.items():\n","    pipeline = Pipeline(steps=[\n","        ('preprocessor', preprocessor_fe),\n","        ('model', model)\n","    ])\n","    pipeline.fit(X_train_fe, y_train)\n","    preds = pipeline.predict(X_val_fe)\n","    rmse = np.sqrt(mean_squared_error(y_val, preds))\n","    results[name] = rmse\n","    models[name] = pipeline  # store fitted pipeline for later use (feature importance, predictions, etc.)\n","\n","for name, rmse in results.items():\n","    print(f\"{name}: RMSE = {rmse:,.2f}\")"]},{"cell_type":"markdown","id":"41e251cb","metadata":{"papermill":{"duration":0.004857,"end_time":"2026-09-25T20:04:49.206707+00:00","exception":false,"start_time":"2026-09-25T20:04:49.20185+00:00","status":"completed"},"tags":[]},"source":["# Predictions and Submission"]},{"cell_type":"code","execution_count":13,"id":"9a632f1b","metadata":{"execution":{"iopub.execute_input":"2026-09-25T20:04:49.218197Z","iopub.status.busy":"2026-09-25T20:04:49.217652Z","iopub.status.idle":"2026-09-25T20:04: